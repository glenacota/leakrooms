{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "plan",
  
  "instructions": [
    "AGENTS.md"
  ],

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": "allow"
  },

  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": {
          "npm test*": "allow",
          "npm run check*": "allow",
          "node --test*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git add*": "ask",
          "git commit*": "ask",
          "git push*": "ask",
          "*": "ask"
        }
      }
    }
  }
}